# Copy to .env.local for local dev; set the same names in Vercel > Settings > Environment Variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Tried in order when the primary is out of quota / overloaded
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Neon Postgres connection string (Neon console > Connect, or added automatically by the Vercel Neon integration)
DATABASE_URL=

# Vaani calls our webhooks with header  x-webhook-secret: <this value>
VAANI_WEBHOOK_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_DESIGNERS_CHAT_ID=
TELEGRAM_FRONTDESK_CHAT_ID=
TELEGRAM_FOUNDER_CHAT_ID=

HUBSPOT_TOKEN=
# Filled in automatically by: npm run setup:hubspot -- --apply
HUBSPOT_PIPELINE_ID=
HUBSPOT_STAGE_NEW=
HUBSPOT_STAGE_CONTACTED=
HUBSPOT_STAGE_BOOKED=
HUBSPOT_STAGE_LOST=

# Nikhil: /dashboard?key=<this value>   Designers: /designers?key=<DESIGNER_KEY>
DASHBOARD_KEY=
DESIGNER_KEY=

# Cost rates, fill from the actual Vaani / Gemini bills (0 = not configured)
TELEPHONY_INR_PER_MIN=0
SPEECH_INR_PER_MIN=0
GEMINI_INPUT_USD_PER_M=0
GEMINI_OUTPUT_USD_PER_M=0
USD_INR=85
